# ScudDocs backend secrets — example file
#
# Copy to backend/.env and replace values for production:
#   cp backend/.env.example backend/.env
#
# backend/.env is gitignored.
#
# Production hardening: для production-окружений рекомендуется
# использовать **Docker secrets** вместо `.env`. Создайте файлы в
# `backend/secrets/`:
# SEC-24: у каждого из 6 postgres-инстансов СВОЙ admin-секрет (утечка одного
# не открывает остальные 5 БД). Создайте все шесть:
#   for s in user locker history auth notification reports; do \
#     echo "$(openssl rand -hex 32)" > "backend/secrets/postgres_${s}_password"; done
#   echo "$(openssl rand -hex 32)" > backend/secrets/jwt_secret
#   echo "$(openssl rand -hex 32)" > backend/secrets/admin_password
#   echo "$(openssl rand -hex 32)" > backend/secrets/internal_auth_hmac_key
#   echo "$(openssl rand -hex 32)" > backend/secrets/redis_password
# Сервисы (`read_secret()` в shared/utils) читают сначала /run/secrets/<name>,
# а если файла нет — fallback на env-переменные ниже. Для dev/CI достаточно
# использовать только `.env` (файлы секретов отсутствуют — env работает).
# `backend/secrets/*` в .gitignore, в репозитории остаётся только .gitkeep.

# Путь к собранному фронтенду (статика для apache_gateway). Дефолт
# `/root/frontend` сохранён только для backwards compatibility с prod-стендами,
# где так уже настроено. **PRODUCTION**: укажите свой абсолютный путь, например
# `/opt/scud/frontend/dist`. В dev/CI директория может отсутствовать —
# apache отдаёт только REST через ProxyPass, статика в этом случае не доступна.
FRONTEND_PATH=/root/frontend

# PostgreSQL admin password — env-fallback ТОЛЬКО для dev/CI и запуска вне
# Docker. В production каждый инстанс читает свой secrets/postgres_<svc>_password
# (SEC-24); этот общий env там не используется.
POSTGRES_PASSWORD=password

# Пароль least-privilege роли acm_ro (SELECT-only), под которой ACM читает
# scud_users (SEC-24). Отделён от admin-пароля postgres_user: компрометация
# read-only канала ACM не даёт записи. В production читается из
# secrets/acm_db_password; этот env — fallback ТОЛЬКО для dev/CI.
# CRITICAL: regenerate for production with `openssl rand -hex 32`.
ACM_DB_PASSWORD=acm_ro_dev_password

# Connection pool sizing per service.
# Каждый backend-сервис использует AsyncPostgres с thread-pool вокруг
# psycopg2.pool.ThreadedConnectionPool. max_workers задаёт ширину пула и
# executor'а; DB_MIN_CONNECTIONS задаёт minconn (нижний порог заранее
# открытых соединений).
#
# По умолчанию minconn = max_workers (тёплый пул): psycopg2 открывает
# соединения под глобальным lock'ом пула; холодный пул (minconn << maxconn)
# сериализует каждый getconn за handshake'ом под нагрузкой (lock convoy).
# Тёплый пул означает, что getconn всегда берёт уже открытое соединение и
# никогда не коннектится на hot-path. Снижение minconn ниже max_workers
# возвращает этот эффект — делайте осознанно.
#
# Hot-сервисы (locker_api, history_api) читают distinct env-переменные
# (DB_MAX_WORKERS_LOCKER, DB_MAX_WORKERS_HISTORY), чтобы единый глобальный
# DB_MAX_WORKERS=5 случайно не приземлил их пулы.
#
# DB_MAX_WORKERS_LOCKER=20
# DB_MIN_CONNECTIONS_LOCKER=20
# DB_MAX_WORKERS_HISTORY=10
# DB_MIN_CONNECTIONS_HISTORY=10
# DB_MAX_WORKERS=5
# DB_MIN_CONNECTIONS=5

# === PgBouncer (транзакционный пулинг соединений) ============================
# Перед 6 PostgreSQL-инстансами стоит по одному пулеру PgBouncer
# (pgbouncer_<instance>:6432). Production-сервисы ходят в БД через свой пулер;
# pool_mode=transaction мультиплексирует короткие транзакции на фикс-пул
# серверных соединений, поэтому суммарное число коннектов к postgres не растёт
# линейно с числом реплик сервисов. Подробности — backend/pgbouncer/README.md.
#
# default_pool_size — серверных соединений к postgres на пару (роль, БД). Сумма
# (default_pool_size + reserve_pool_size) по всем 6 пулерам должна укладываться
# в postgres max_connections (дефолт 100) с запасом на superuser/служебные
# подключения. Per-instance дефолты заданы в docker-compose.yaml: low-QPS
# (user/acm, auth, notification, reports) — 10-15, hot (locker/history) — 25-30.
# Раскомментируйте для переопределения:
# PGB_DEFAULT_POOL_SIZE_USER=15
# PGB_DEFAULT_POOL_SIZE_LOCKER=30
# PGB_DEFAULT_POOL_SIZE_HISTORY=25
# PGB_DEFAULT_POOL_SIZE_AUTH=10
# PGB_DEFAULT_POOL_SIZE_NOTIFICATION=10
# PGB_DEFAULT_POOL_SIZE_REPORTS=10
# reserve_pool_size — доп. серверные соединения при всплеске (выдаются с
# задержкой reserve_pool_timeout). Общий для всех пулеров.
# PGB_RESERVE_POOL_SIZE=5
# max_client_conn — потолок клиентских подключений к самому пулеру (frontend).
# Высокий: thread-pool каждого сервиса × число реплик; к postgres всё равно
# уходит не больше default_pool_size одновременно.
# PGB_MAX_CLIENT_CONN=200
# Режим пулинга. ИЗМЕНЯТЬ НЕ РЕКОМЕНДУЕТСЯ: код опирается на инвариант «один
# execute = одна транзакция = один checkout» (см. backend/CONVENTIONS.md);
# session-режим снял бы кап коннектов, statement-режим сломал бы multi-statement
# DDL миграций. Дефолт transaction зашит в шаблоне pgbouncer.ini.template.
# PGB_POOL_MODE=transaction

# TTL кэша operational_status на hot path mqtt-ingest (_op_status,
# ingest.py; секунды). Дефолт 30s — компромисс между «не дёргать БД на
# каждый батч телеметрии» и «реактивная реакция на смену MAINTENANCE через
# REST». В fast-mode E2E (.env.fast: telemetry_interval=1s) кэш понижается
# до 1s, чтобы тест test_telemetry_suppressed_in_maintenance не ловил race.
# RELAY_OP_STATUS_TTL_S=30

# JWT secret used by auth_api for session tokens.
# CRITICAL: regenerate for production with `openssl rand -hex 32`
JWT_SECRET=change-me-in-production-must-be-at-least-32-bytes-long

# Initial admin user password (used by user_api on first start)
ADMIN_PASSWORD=changeme

# Redis (used by ACM cache + user_api invalidation hook).
# CRITICAL: regenerate REDIS_PASSWORD for production with `openssl rand -hex 32`.
# Дефолт в compose — `redis-dev-only-do-not-use-in-prod`, в проде обязательно
# переопределить здесь.
REDIS_PASSWORD=redis-dev-only-do-not-use-in-prod
# REDIS_URL подставляется автоматически из REDIS_PASSWORD; переопределите
# целиком, только если Redis вынесен из docker-compose.
# REDIS_URL=redis://:secret@redis:6379/0

# Длина сессии access-токена (часы). По умолчанию 24h.
# ACCESS_TOKEN_TTL_HOURS=24

# Cookie с флагом Secure. compose-дефолт `true` (secure-by-default) — так что
# просто оставить переменную неустановленной в production безопасно. dev/test,
# которые ходят по HTTP, явно понижают её до `false` (см. `.env.fast` и
# `.github/workflows/tests.yml`), иначе access_token cookie не резолвится
# обратно клиентом на HTTP-соединении.
SECURE_COOKIES=true

# Rate-limit на /auth/verify (per-IP). compose-дефолт 100/60s — высокий,
# чтобы integration-тесты не упирались. В prod снизьте до 10/60s.
VERIFY_RATE_LIMIT=10
VERIFY_RATE_WINDOW_SECONDS=60

# CORS Allow-Origin для preflight/cross-origin запросов от фронтенда.
# Подставляется в `Access-Control-Allow-Origin` на gateway (apache.conf via
# entrypoint sed-replace). PRODUCTION: установить конкретный origin фронтенда,
# например:
#   CORS_ALLOWED_ORIGIN=https://scud.example.com
# Wildcard `*` допустим только для dev/integration tests
# (несовместим с Access-Control-Allow-Credentials, а cookie у нас
# Secure+SameSite=Strict).
CORS_ALLOWED_ORIGIN=*

# HMAC ключ для подписи внутренних auth_api ↔ user_api запросов
# (POST /internal/auth/check). auth_api добавляет
# X-Internal-Timestamp + X-Internal-Signature, user_api валидирует и
# отвергает несовпадающие/устаревшие (>30s) подписи. Защищает от
# replay перехваченного password_hash злоумышленником в backend_net.
# CRITICAL: regenerate for production with `openssl rand -hex 32`.
# Дефолт в compose — `internal-auth-dev-key-do-not-use-in-prod`.
# Должен быть **одинаковым** в auth_api и user_api.
INTERNAL_AUTH_HMAC_KEY=internal-auth-dev-key-do-not-use-in-prod

# HMAC ключ для подписи внутренних запросов записи в history_api
# (POST /internal/api/v1/{events/security,telemetry,media}). Продьюсеры
# (locker_api OutboundDispatcher/StepUpEventProducer, auth_api
# SecurityEventProducer) добавляют X-Internal-Timestamp + X-Internal-Signature
# над sha256(body); history_api валидирует и отвергает несовпадающие/устаревшие
# (>30s) подписи. Защищает AUDIT-трейл (включая command_2fa_*) от подделки/флуда
# скомпрометированным контейнером в backend_net (SEC-05).
# CRITICAL: regenerate for production with `openssl rand -hex 32`.
# Должен быть **одинаковым** в history_api, locker_api и auth_api.
INTERNAL_HISTORY_HMAC_KEY=internal-history-dev-key-do-not-use-in-prod

# HMAC ключ подписи внутренних OTP-запросов (auth_api → notification_api).
# CRITICAL: regenerate for production with `openssl rand -hex 32`.
# Должен быть **одинаковым** на обоих концах.
INTERNAL_OTP_HMAC_KEY=internal-otp-dev-key-do-not-use-in-prod

# HMAC ключ подписи внутренних step-up (2FA подтверждение команды) запросов
# между locker_api и auth_api.
# CRITICAL: regenerate for production with `openssl rand -hex 32`.
INTERNAL_STEP_UP_HMAC_KEY=internal-step-up-dev-key-do-not-use-in-prod

# HMAC ключ подписи внутренних запросов привязки Max-аккаунта
# (user_api ↔ notification_api).
# CRITICAL: regenerate for production with `openssl rand -hex 32`.
INTERNAL_MAX_BINDING_HMAC_KEY=internal-max-binding-dev-key-do-not-use-in-prod

# HMAC ключ подписи внутренних PII-read запросов в user_api:
# /internal/user/by-phone, /internal/user/{id}, /internal/users/names.
# auth_api и reports_api подписывают, user_api проверяет (SEC-10).
# CRITICAL: regenerate for production with `openssl rand -hex 32`.
# Должен быть **одинаковым** в user_api, auth_api и reports_api.
INTERNAL_USER_READ_HMAC_KEY=internal-user-read-dev-key-do-not-use-in-prod

# HMAC ключ подписи внутренних запросов отзыва сессий:
# /internal/api/v1/sessions/revoke. user_api подписывает после смены пароля /
# 2FA, auth_api проверяет и отзывает живые сессии пользователя (SEC-14).
# CRITICAL: regenerate for production with `openssl rand -hex 32`.
# Должен быть **одинаковым** в user_api и auth_api.
INTERNAL_SESSION_REVOKE_HMAC_KEY=internal-session-revoke-dev-key-do-not-use-in-prod

# === MQTT (брокер relay-плат) ================================================
# Адрес, на котором mosquitto слушает 1883. Дефолт 127.0.0.1 — брокер виден
# только на хосте (для теста/локалки). На стенде с реальными платами
# переопределите на 0.0.0.0, чтобы платы из LAN могли подключиться.
MQTT_BIND_ADDR=127.0.0.1

# TLS-терминатор релейного брокера (профиль mqtt-tls, порт 8883).
MQTT_TLS_BIND_ADDR=127.0.0.1
MQTT_TLS_CERT_DIR=./mqtt-tls/certs
# Пароль backend-пользователя scud_backend в брокере. Должен совпадать с
# secrets/mqtt_password (если используется Docker secret) или этим значением.
# CRITICAL: regenerate for production with `openssl rand -hex 32`.
MQTT_PASSWORD=scud_backend_dev_password
# Таймаут (с) без сообщений от платы, после которого locker_api помечает её
# offline, и интервал фоновой проверки этого таймаута.
MQTT_OFFLINE_TIMEOUT_S=350
MQTT_OFFLINE_CHECK_INTERVAL_S=30

# === MQTT ingest bulkhead + OutboundDispatcher (locker_api) =================
# Ограничивают параллелизм горячего пути реле, не добавляя зависимостей.
#
# MQTT_INGEST_MAX_CONCURRENCY — сколько handle_message выполняется одновременно
# (семафор над пулом БД). Держите ≤ DB_MAX_WORKERS_LOCKER − ~4 (headroom для
# /health и доставки команд). Дефолт 10 при pool=20 оставляет 10 слотов.
# MQTT_INGEST_MAX_CONCURRENCY=10
#
# MQTT_INGEST_MAX_PENDING — суммарный лимит задач (выполняющихся + ожидающих
# семафора). Превышение: loss-tolerant сообщения (stat/telemetry) отбрасываются
# и считаются как scud_mqtt_relay_messages_total{outcome="dropped_overload"};
# rep (ответы на команды) никогда не отбрасываются.
# MQTT_INGEST_MAX_PENDING=1000
#
# MQTT_INGEST_PHOTO_MAX_CONCURRENCY — отдельный семафор для кадров photos.
# Сумма с MQTT_INGEST_MAX_CONCURRENCY ≤ DB_MAX_WORKERS_LOCKER − 4.
# MQTT_INGEST_PHOTO_MAX_CONCURRENCY=2
#
# MQTT_INGEST_PHOTO_MAX_PENDING_BYTES — бюджет байт выполняющихся и ожидающих
# кадров photos; сверх него кадр отбрасывается (dropped_overload). Не меньше
# MAX_MEDIA_TRANSFER_BYTES + 20.
# MQTT_INGEST_PHOTO_MAX_PENDING_BYTES=268435456
#
# RELAY_PHOTO_SERIES_EPOCH_S — сколько секунд event_id платы считается тем же
# инцидентом; позже кадр с тем же event_id начинает новую серию.
# RELAY_PHOTO_SERIES_EPOCH_S=86400
# RELAY_PHOTO_SERIES_MAX_BYTES — лимит суммарного размера кадров одной серии.
# RELAY_PHOTO_SERIES_MAX_BYTES=10485760
# RELAY_PHOTO_SERIES_RATE / _BURST — новых серий в секунду на одну плату.
# RELAY_PHOTO_SERIES_RATE=0.1
# RELAY_PHOTO_SERIES_BURST=10
# RELAY_PHOTO_SERIES_RETENTION_DAYS — хранение реестра серий.
# RELAY_PHOTO_SERIES_RETENTION_DAYS=90
# RELAY_PHOTO_MAINTENANCE_INTERVAL_S — период фоновой досылки intrusion по
# сериям и очистки реестра.
# RELAY_PHOTO_MAINTENANCE_INTERVAL_S=60
#
# OUTBOUND_DISPATCHER_CONCURRENCY — число параллельных POST в history_api за
# один цикл OutboundDispatcher. Поднимите при большом outbox-бэклоге.
# OUTBOUND_DISPATCHER_CONCURRENCY=6

# === Rate-limit логина (auth_api /auth/login) ===============================
# compose-дефолт 100/60s — высокий, чтобы integration-тесты не упирались.
# В prod снизьте (например 10/60s).
LOGIN_RATE_LIMIT=100
LOGIN_RATE_WINDOW_SECONDS=60

# === Периодические интервалы locker_api (prod-дефолты) ======================
# Это значения по умолчанию для prod; .env.fast понижает их для E2E.
# COMMAND_QUEUE_PROCESSOR_INTERVAL_S — частота поллинга БД-очереди команд (с).
# Значение 5 балансирует задержку доставки команды переподключившемуся
# устройству против частоты опроса БД-очереди (был 30 — устройство ждало до 30с).
COMMAND_QUEUE_PROCESSOR_INTERVAL_S=5
# Частота проверки порогов датчиков и отправки алертов (с).
STATE_MONITOR_CHECK_INTERVAL_S=60
# Частота sweep'а команд, зависших в 'sent' (ack-timeout reset/fail) (с).
COMMAND_ACK_TIMEOUT_LOOP_INTERVAL_S=60
# Сколько минут команда висит в 'sent' до reset→pending / fail (мин).
COMMAND_ACK_TIMEOUT_MINUTES=5
# Срок жизни команды от создания: без ответа шкафа она становится failed
# и больше не отправляется (с).
COMMAND_TTL_S=60
# Частота поллинга outbox-таблицы диспетчером доставки событий в history_api (с).
OUTBOUND_DISPATCHER_POLL_INTERVAL_S=2

# Доверенный hop для mod_remoteip на gateway (SEC-07): CIDR апстрим-прокси,
# которому разрешено проставлять X-Forwarded-For. Дефолт 127.0.0.1/8 — только
# локальный балансировщик. PRODUCTION: укажите CIDR вашего фронт-LB.
TRUSTED_PROXY_CIDR=127.0.0.1/8

# === Max-бот (OTP-доставка, profile manual/realtest) ========================
# Базовый URL платформенного API Max и username бота. Токен бота — отдельный
# секрет secrets/max_bot_token (не кладите его сюда).
MAX_BOT_API_URL=https://platform-api.max.ru
MAX_BOT_USERNAME=

# === SMS-шлюз Yeastar (OTP-доставка, profile sms) ===========================
# notification_api ходит на sidecar wg_gateway, который туннелирует к шлюзу.
# Пусто на dev/CI (транспорт SMS не поднимается, OTP уходит в MAX/queue).
SMS_GATEWAY_URL=
SMS_MIN_INTERVAL_SECONDS=10
SMS_MAX_QUEUE_WAIT_SECONDS=10
SMS_GATEWAY_TIMEOUT_SECONDS=25
MAX_SEND_TIMEOUT_SECONDS=8
OTP_DELIVERY_TIMEOUT_SECONDS=45
STEP_UP_ISSUE_TIMEOUT_SECONDS=50
# Параметры WireGuard-сайдкара (значения — из SKYD_init.conf, ключи в secrets).
# SMS_GATEWAY_HOST — Keenetic 10.8.0.19, пробрасывающий :7777 на TG200.
WG_ADDRESS=10.8.0.14/24
WG_KEEPALIVE=25
WG_PEER_PUBKEY=
WG_ENDPOINT=94.103.85.33:29156
WG_ALLOWED_IPS=10.8.0.0/24
SMS_GATEWAY_HOST=10.8.0.19
SMS_GATEWAY_PORT=7777

# === Backup-сидекар (profile backup) ========================================
# TTL дампов (суток) и период между авто-дампами (с, default 86400 = сутки).
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400

# === Окружение приложения ====================================================
# Режим работы сервисов: development | production. В production включается
# fail-closed поведение (строгая валидация секретов/конфигурации на старте).
# Для dev/CI оставьте development.
APP_ENV=development
