# E2E acceleration profile for backend services.
#
# Apply via:
#   docker compose --env-file .env.fast up -d
#
# Reduces periodic intervals so E2E tests don't wait 30-60s per state_monitor
# cycle. NOT for production — production uses the default values from
# docker-compose.yaml (60s/30s/etc.).

# State machine — реактивная скорость для тестов
STATE_MONITOR_CHECK_INTERVAL_S=2
COMMAND_QUEUE_PROCESSOR_INTERVAL_S=2
COMMAND_ACK_TIMEOUT_LOOP_INTERVAL_S=30
COMMAND_ACK_TIMEOUT_MINUTES=1
COMMAND_TTL_S=60
OUTBOUND_DISPATCHER_POLL_INTERVAL_S=1

# MQTT релейный транспорт — быстрый offline-флип для e2e.
# Prod-дефолт 350s/30s (см. docker-compose.yaml); тут понижаем, иначе
# test_relay_goes_offline_after_silence / test_relay_reconnect_resubscribe
# не дожидаются перехода шкафа в offline за свой бюджет ожидания (70s).
MQTT_OFFLINE_TIMEOUT_S=40
MQTT_OFFLINE_CHECK_INTERVAL_S=3
# system-e2e: scud_relay double подключается к брокеру через host-gateway из
# отдельного compose-проекта (tests/system), поэтому в e2e публикуем брокер на
# 0.0.0.0. Prod/dev оставляют дефолт 127.0.0.1 (INF-01/SEC-04).
MQTT_BIND_ADDR=0.0.0.0

# TTL кэша operational_status в mqtt-ingest (_op_status, ingest.py; дефолт в
# коде 30s). В fast-mode с telemetry_interval=1s дефолт перекрывает несколько
# циклов телеметрии — `test_telemetry_suppressed_in_maintenance` падает на
# race: `PATCH /state {operational_status: maintenance}` приходит, но кэш
# всё ещё держит `normal`, телеметрия проходит. Также без понижения флакует
# `test_maintenance_to_normal_transition`: кэш ещё держит maintenance после
# возврата в normal.
RELAY_OP_STATUS_TTL_S=1

# docker-compose.yaml secure-by-default — SECURE_COOKIES=${SECURE_COOKIES:-true}.
# system-e2e (tests/system) ходит к gateway/auth_api по plain HTTP и полагается
# на автопересылку access_token cookie между запросами одной requests.Session;
# Secure-cookie клиент не резолвит обратно на HTTP-соединении. Явно понижаем.
SECURE_COOKIES=false
