# директория для Docker secrets file-mounts.
#
# Назначение: backend/docker-compose.yaml ссылается на файлы в этой
# директории через top-level `secrets:` блок (postgres_<svc>_password ×6 —
# по секрету на инстанс, SEC-24; jwt_secret, admin_password,
# internal_auth_hmac_key, redis_password, acm_db_password, mqtt_password).
#
# Обычные файлы здесь добавлены в .gitignore — никаких реальных
# секретов в репозитории. .gitkeep удерживает пустую директорию в git.
#
# Production deployment (по секрету на postgres-инстанс, SEC-24):
#   for s in user locker history auth notification reports; do \
#     echo "..." > "backend/secrets/postgres_${s}_password"; done
#   echo "..." > backend/secrets/jwt_secret
#   echo "..." > backend/secrets/admin_password
#   echo "..." > backend/secrets/internal_auth_hmac_key
#   echo "..." > backend/secrets/redis_password
#
# Если файлы отсутствуют — backend-сервисы используют env-fallback
# через `read_secret()` (см. backend/shared/utils/__init__.py).
